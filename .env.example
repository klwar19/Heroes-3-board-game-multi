NEXT_PUBLIC_APP_NAME="Heroes 3 Board Game Multi"

# --- Accounts (expansion plan Phase 1) -------------------------------------
# Accounts are OFF by default: with none of these set, the app runs in guest
# mode exactly as before (per-tab clientId + free-text display name, no login
# wall). That default is what CI, vitest and the Playwright e2e run against.
#
# Turn on the built-in, self-hosted account backend (register / email confirm /
# login / password reset / profiles / admin) — no external service required:
# NEXT_PUBLIC_ACCOUNTS_ENABLED="1"
#
# Absolute origin used to build the confirmation / reset links in emails:
# HOMM3BG_PUBLIC_URL="https://your-deployment.example"
#
# The account store persists to this directory (default: a temp dir under the
# OS tmpdir — set a durable path in production so accounts survive restarts).
# scripts/seed-admin.ts must use the SAME value.
# HOMM3BG_ACCOUNT_DIR="/var/lib/homm3bg/accounts"
#
# This email is auto-promoted to admin on registration and every boot
# (alternative to running scripts/seed-admin.ts):
# HOMM3BG_ADMIN_EMAIL="you@example.com"
#
# Mail transport. Default logs the confirmation/reset LINK to the server console
# (dev). "capture" keeps mail in memory and echoes the confirm link in the
# register API response (local testing without an inbox). Real SMTP is the
# production swap point documented in src/server/accounts/mailer.ts
# (createMailerFromEnv); it is not wired here because it can't be tested offline.
# HOMM3BG_MAIL_TRANSPORT="capture"

# --- Supabase (reserved for the future auth/database adapter, §D1) ----------
# When set, NEXT_PUBLIC_SUPABASE_URL also flips accounts ON (same UI, a Supabase
# store instead of the built-in one). Not yet implemented — the built-in backend
# above is the shipped path.
# NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# PartyKit / Cloudflare Durable Objects multiplayer backend (optional).
# Deploy with `npx partykit login` then `npx partykit deploy`, and put the
# printed host here; leave unset to use the built-in Next.js room store + SSE
# stream.
# NEXT_PUBLIC_PARTYKIT_HOST="heroes3bg-rooms.<your-user>.partykit.dev"

# Static asset origin (optional). All /assets and /sounds paths are routed
# through assetUrl() in src/lib/asset-url.ts. Leave unset to serve them from
# /public on the app's own host (default). Set it to a CDN / Cloudflare R2
# domain to serve images and sounds from there instead — no other code change.
# NOTE: three background images hard-coded in src/app/globals.css cannot use
# this (CSS can't call JS); update those URLs by hand if you move everything.
# NEXT_PUBLIC_ASSET_BASE_URL="https://assets.example.com"
